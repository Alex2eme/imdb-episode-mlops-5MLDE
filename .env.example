# Copier en .env puis adapter. Le fichier .env est ignoré par Git.

# --- PostgreSQL ---
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Utilisateur PostgreSQL en lecture seule utilisé par Grafana.
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# --- URLs utilisées par le code Python lancé depuis l'hôte ---
MLFLOW_TRACKING_URI=http://localhost:5000
DATABASE_URL=postgresql+psycopg://mlops:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# --- Optionnel ---
# Webhook (Discord/Slack) pour les alertes ; vide = alertes uniquement en logs.
ALERT_WEBHOOK_URL=
# Jeton GitHub (lecture publique) pour éviter la limite de 60 requêtes/h de l'API.
GITHUB_TOKEN=

# --- API ---
# Jeton de l'endpoint /admin/reload (en-tête X-Admin-Token) ; vide = désactivé.
ADMIN_TOKEN=change-me-admin
